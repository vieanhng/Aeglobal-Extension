{
    "manifest_version": 3,
    "name": "Aeglobal Tools",
    "version": "3.0.9",
    "description": "Automation tool for aeglobal lms",
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "sidePanel"
    ],
    "host_permissions": [
        "https://aeglobal.lotuslms.com/*",
        "https://aeglobal2.lotuslms.com/*",
        "<all_urls>"
    ],
    "options_page": "options.html",
    "side_panel": {
        "default_path": "module/sidepanel/sidepanel.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://aeglobal.lotuslms.com/*",
                "https://aeglobal2.lotuslms.com/*"
            ],
            "js": [
                "content_script.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "module/sidepanel/interceptor.js"
            ],
            "matches": [
                "https://aeglobal.lotuslms.com/*",
                "https://aeglobal2.lotuslms.com/*"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}